---
import { profile, socialLinks } from '../data/portfolio';
import SocialIcon from './SocialIcon.astro';
import Terminal from './Terminal.astro';
---

<section id="inicio" class="hero">
	<div class="container hero-inner">
		<div class="hero-main">
			<p class="hero-greeting">Hola, soy</p>
			<h1 class="hero-name">{profile.name}</h1>
			<p class="hero-role">{profile.role}</p>
			<p class="hero-tagline">{profile.tagline}</p>

			<div class="hero-actions">
				<a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
				<a href="#contacto" class="btn btn-outline">Contactar</a>
			</div>
		</div>

		<div class="hero-social">
			{
				socialLinks.map((link) => (
					<a
						href={link.url}
						target={link.icon === 'email' ? undefined : '_blank'}
						rel={
							link.icon === 'email'
								? undefined
								: 'noopener noreferrer'
						}
						class="social-link"
						aria-label={link.name}
					>
						<SocialIcon icon={link.icon} size={22} />
					</a>
				))
			}
		</div>

		<div class="hero-terminal">
			<Terminal />
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding-top: var(--header-height);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: -200px;
		right: -200px;
		width: 600px;
		height: 600px;
		background: radial-gradient(
			circle,
			var(--color-accent-glow) 0%,
			transparent 70%
		);
		pointer-events: none;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-areas:
			'main terminal'
			'social terminal';
		gap: 2rem 4rem;
		align-items: center;
		padding-block: 4rem;
		width: 100%;
		min-width: 0;
	}

	.hero-main {
		grid-area: main;
		min-width: 0;
	}

	.hero-social {
		grid-area: social;
		display: flex;
		gap: 1.25rem;
		min-width: 0;
	}

	.hero-terminal {
		grid-area: terminal;
		min-width: 0;
		align-self: center;
	}

	.hero-greeting {
		font-family: var(--font-mono);
		color: var(--color-accent);
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}

	.hero-name {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: 0.5rem;
	}

	.hero-role {
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		color: var(--color-text-muted);
		font-weight: 500;
		margin-bottom: 1rem;
	}

	.hero-tagline {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		max-width: 480px;
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		transition: all var(--transition);
	}

	.social-link:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
		box-shadow: 0 0 16px var(--color-accent-glow);
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			grid-template-areas:
				'main'
				'social'
				'terminal';
			gap: 2rem;
			text-align: center;
		}

		.hero-main {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.hero-tagline {
			margin-inline: auto;
		}

		.hero-actions {
			justify-content: center;
		}

		.hero-social {
			justify-content: center;
		}

		.hero-terminal {
			width: 100%;
		}
	}
</style>
