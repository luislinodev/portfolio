---
import { profile, stats } from '../data/portfolio';
---

<section id="sobre-mi" class="section about">
	<div class="container">
		<h2 class="section-title">Sobre mí</h2>
		<p class="section-subtitle">Conoce un poco más sobre mi trayectoria</p>

		<div class="about-grid">
			<div class="about-text">
				<p>{profile.bio}</p>

				<ul class="about-details">
					<li>
						<span class="detail-label">Formación</span>
						<span class="detail-value"
							>Diseño y Desarrollo de Software - Certus</span
						>
					</li>
					<li>
						<span class="detail-label">Ubicación</span>
						<span class="detail-value">{profile.location}</span>
					</li>
					<li>
						<span class="detail-label">Email</span>
						<a
							href={`mailto:${profile.email}`}
							class="detail-value detail-link">{profile.email}</a
						>
					</li>
					<li>
						<span class="detail-label">Disponibilidad</span>
						<span class="detail-value available"
							>Abierto a oportunidades</span
						>
					</li>
				</ul>
			</div>

			<div class="about-stats">
				{
					stats.map((stat) => (
						<div class="stat-card">
							<span class="stat-number">{stat.value}</span>
							<span class="stat-label">{stat.label}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		background: var(--color-bg-secondary);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.about-text p {
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
		font-size: 1.05rem;
	}

	.about-details {
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about-details li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.detail-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-accent);
		font-family: var(--font-mono);
	}

	.detail-value {
		font-size: 1rem;
		color: var(--color-text);
	}

	.detail-link {
		transition: color var(--transition);
	}

	.detail-link:hover {
		color: var(--color-accent);
	}

	.available {
		color: #28c840;
	}

	.about-stats {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.stat-card {
		background: var(--color-bg-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.5rem;
		text-align: center;
		transition: border-color var(--transition);
	}

	.stat-card:hover {
		border-color: var(--color-accent);
	}

	.stat-number {
		display: block;
		font-size: clamp(1.2rem, 4vw, 1.75rem);
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1.1;
		margin-bottom: 0.5rem;
		font-family: var(--font-mono);

		overflow-wrap: anywhere;
	}

	.stat-label {
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about-stats {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.stat-card {
			flex: 1;
			min-width: 140px;
		}
	}
</style>
